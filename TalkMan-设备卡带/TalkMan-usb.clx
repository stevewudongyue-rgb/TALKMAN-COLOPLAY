coloX-16
version 1
style:util
name:TALKMAN COLOPLAY USB
author:Cololight
desc:纯 USB 桌面控制器，无需 Wi-Fi，初代 240×240

__lua__
#include TalkMan-连接配置.lua
#include TalkMan-版本.lua
#include TalkMan-手势.lua
#include TalkMan-更新组合.lua
#include TalkMan-屏幕.lua
#include TalkMan-USB通道.lua
local usb=TMUsbTransport(TM_CONFIG)
function _init() btnpcfg(255,0) end
function _update() usb:step(stat(12),true) end
function _draw()
 if usb:draw() then return end
 TMDraw({now=stat(12),ready=false,configured=false,buttons={},exit_ms=5000,device_build=TM_DEVICE_BUILD,
  connection_hint=img_scrair and '电脑连接 USB' or '请升级图流固件'})
end
function _idle_update() usb:resume() end
function _idle_draw()
 TMDraw({now=stat(12),ready=false,buttons={},exit_ms=5000,inactive=true,device_build=TM_DEVICE_BUILD})
end
